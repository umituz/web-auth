{
  "name": "@umituz/web-auth",
  "version": "1.0.2",
  "description": "Frontend auth module for the fleet — AuthLayout, Login/Register/Forgot/Reset forms, SessionProvider with an AuthAdapter seam, org switcher, demo login; uauth-* stylesheet on design-system tokens",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./types": "./src/types/index.ts",
    "./session": "./src/session/index.ts",
    "./styles.css": "./src/styles/auth.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@umituz/web-design-system": "^4.8.1",
    "lucide-react": "^0.577.0",
    "@umituz/web-localization": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.0.2",
    "react-router-dom": "^7.13.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "auth",
    "authentication",
    "login",
    "register",
    "forgot-password",
    "reset-password",
    "session",
    "session-provider",
    "auth-adapter",
    "org-switcher",
    "multi-tenant",
    "password-strength",
    "auth-layout",
    "react",
    "typescript",
    "components"
  ],
  "author": "umituz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umituz/web-auth.git"
  },
  "bugs": {
    "url": "https://github.com/umituz/web-auth/issues"
  },
  "homepage": "https://github.com/umituz/web-auth#readme"
}
